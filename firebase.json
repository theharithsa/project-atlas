{
  "hosting": {
    "site": "the-harithsa-notes-pipeline",
    "public": "site",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/*.json"
    ],
    "rewrites": [
      {
        "source": "/api/v1/portfolio",
        "function": {
          "functionId": "atlasPublicFeed",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/v1/owners/**",
        "function": {
          "functionId": "atlasPublicFeed",
          "region": "us-east1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "project-atlas",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "**/.*",
        "test",
        "firebase-debug.log",
        "*-debug.log"
      ]
    }
  ]
}
